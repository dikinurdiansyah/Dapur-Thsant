# Template pengembangan lokal; otomatis disalin oleh `composer setup`.
# Untuk production pakai .env.production.example.

APP_NAME="Dapur TH Sant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL lokal (XAMPP/Laragon). Buat dulu database-nya:
#   CREATE DATABASE db_katalog_order_online_umkm_2 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_katalog_order_online_umkm_2
DB_USERNAME=root
# Isi hanya jika user MySQL lokal Anda memakai password.
DB_PASSWORD=

# Tidak ada tabel sessions di migrasi proyek ini, jadi session disimpan di file.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false agar login lewat http://127.0.0.1:8000 tetap jalan.
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Aplikasi belum mengirim email; semua mail hanya ditulis ke log.
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
