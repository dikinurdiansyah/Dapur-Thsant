# Template production. Salin manual (bukan lewat composer setup):
#   cp .env.production.example .env
# Ganti semua nilai <...> sebelum dipakai.

APP_NAME="Dapur TH Sant"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=<host-database>
DB_PORT=3306
DB_DATABASE=<nama-database>
DB_USERNAME=<user-database>
DB_PASSWORD=<password-database>

# Tidak ada tabel sessions di migrasi proyek ini, jadi session disimpan di file.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true karena production diakses lewat HTTPS.
SESSION_SECURE_COOKIE=true

# Bukti transfer pelanggan disimpan privat di storage/app/private (harus persisten & writable).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Aplikasi belum mengirim email; semua mail hanya ditulis ke log.
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Setelah nilai di atas diisi: key:generate -> migrate --force (tanpa db:seed) ->
# storage:link -> npm ci && npm run build -> admin:create -> config/route/view:cache
